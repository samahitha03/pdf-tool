#!/bin/bash
# pdftool — launch the local PDF Tool and open it in the browser.
#   pdftool         start (if needed) and open the UI
#   pdftool stop    stop the server
#   pdftool status  check whether the server is running

# The project folder is wherever this script lives, following symlinks so it
# can be linked onto the PATH (e.g. ~/.local/bin/pdftool).
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *)  SOURCE="$(dirname "$SOURCE")/$TARGET" ;;
  esac
done
DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
URL="http://127.0.0.1:5177"

# macOS has `open`; most Linux desktops have `xdg-open`.
open_url() {
  if command -v open >/dev/null 2>&1; then open "$1"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$1" >/dev/null 2>&1
  else echo "Open $1 in your browser."
  fi
}

is_running() {
  curl -s -o /dev/null -m 1 "$URL/"
}

case "${1:-open}" in
  stop)
    if lsof -ti :5177 | xargs kill 2>/dev/null; then
      echo "PDF Tool stopped."
    else
      echo "PDF Tool is not running."
    fi
    ;;
  status)
    if is_running; then
      echo "PDF Tool is running at $URL"
    else
      echo "PDF Tool is not running. Start it with: pdftool"
    fi
    ;;
  open|*)
    if is_running; then
      # The running server holds this launch's key; a tab that still has the
      # session cookie is let in, and one that does not is told to restart.
      echo "Already running — opening $URL"
      echo "  (if the tab says it has no key: pdftool stop && pdftool)"
      open_url "$URL"
    else
      echo "Starting PDF Tool..."
      nohup "$DIR/run.sh" > "$DIR/server.log" 2>&1 &
      # app.py opens the browser itself once the server is up;
      # wait briefly and confirm it started.
      for i in {1..10}; do
        sleep 1
        if is_running; then
          echo "Running at $URL (stop with: pdftool stop)"
          exit 0
        fi
      done
      echo "Failed to start — check $DIR/server.log"
      exit 1
    fi
    ;;
esac
